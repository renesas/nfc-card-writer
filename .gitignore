# e2 studio / Eclipse build output
Debug/
Release/
*_Debug/
*_Release/

# FSP / RASC generated trees.
#
# These are NOT deliverables: e2 studio (or RASC) regenerates them from
# configuration.xml when the project is imported and "Generate Project Content"
# runs, so they are absent from a fresh clone by design. Committing them would
# pin generated output to one FSP install and one toolchain path.
examples/fpb-ra2e3/ra/
examples/fpb-ra2e3/ra_gen/
examples/fpb-ra2e3/ra_cfg/
examples/fpb-ra2e3/ra_cfg.txt

# JLink logs / local debug state
*.log
*.jlink
.settings/eventpointSettings

# Eclipse workspace metadata
.metadata/

# OS files
.DS_Store
Thumbs.db

# RASC / e2 studio regenerate these on import or build, and some embed
# machine-specific toolchain paths. Not deliverables.
examples/fpb-ra2e3/.api_xml
examples/fpb-ra2e3/.clangd
examples/fpb-ra2e3/.secure_azone
examples/fpb-ra2e3/.secure_rzone
examples/fpb-ra2e3/.secure_xml
examples/fpb-ra2e3/.settings/language.settings.xml

# Launch configurations e2 studio auto-creates from the binary name
# (e.g. "RA2E3_nfc_writer.elf (1).launch"). The shipped, supported
# configuration is Debug_Flat.launch.
examples/fpb-ra2e3/*.elf*.launch

# VS Code / CMake build (see examples/fpb-ra2e3/CMakeLists.txt)
examples/fpb-ra2e3/build/
# Generated by RASC at the project root during a CMake configure
examples/fpb-ra2e3/memory_regions.lld
examples/fpb-ra2e3/fsp_gen.lld
examples/fpb-ra2e3/bsp_linker_info.h
